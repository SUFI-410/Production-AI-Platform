# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Models
CHAT_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small

# Generation
TEMPERATURE=0.0
OPENAI_REQUEST_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=1
OPENAI_REASONING_EFFORT=low

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval
TOP_K=8

# Chroma
CHROMA_DIRECTORY=chroma_db

# Website crawler
REQUEST_TIMEOUT=20
USER_AGENT=Production-RAG/1.0

# Cloudflare Turnstile
TURNSTILE_SECRET=your_cloudflare_turnstile_secret

# PostgreSQL
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://rag_user:change_me@postgres:5432/rag_platform

# Document storage
DOCUMENT_STORAGE_DIR=data/uploads

# Authentication
JWT_SECRET_KEY=replace_with_secure_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
